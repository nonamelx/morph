{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nonamelx/morph/blob/main/themes/profile.schema.json",
  "title": "Morph theme profile v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "name", "description", "payload"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "minLength": 1, "maxLength": 200},
    "payload": {
      "type": "object", "additionalProperties": false, "required": ["codeThemeId", "theme", "variant"],
      "properties": {
        "codeThemeId": {"enum": ["one", "one-dark", "nord", "dracula", "catppuccin", "gruvbox", "solarized", "github-light", "tokyo-night", "matrix"]}, "variant": {"enum": ["dark", "light"]},
        "theme": {
          "type": "object", "additionalProperties": false,
          "required": ["accent", "contrast", "fonts", "ink", "opaqueWindows", "semanticColors", "surface"],
          "properties": {
            "accent": {"$ref": "#/$defs/color"}, "ink": {"$ref": "#/$defs/color"}, "surface": {"$ref": "#/$defs/color"},
            "contrast": {"type": "integer", "minimum": 0, "maximum": 100},
            "opaqueWindows": {"type": "boolean"},
            "fonts": {"type": "object", "additionalProperties": false, "required": ["code", "ui"], "properties": {"code": {"type": ["string", "null"], "maxLength": 100}, "ui": {"type": ["string", "null"], "maxLength": 100}}},
            "semanticColors": {"type": "object", "additionalProperties": false, "required": ["diffAdded", "diffRemoved", "skill"], "properties": {"diffAdded": {"$ref": "#/$defs/color"}, "diffRemoved": {"$ref": "#/$defs/color"}, "skill": {"$ref": "#/$defs/color"}}}
          }
        }
      }
    }
  },
  "$defs": {"color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}
}
